# Written by deploy.sh. Copy it by hand only if you want to set something up yourself.
#
# The two secrets have no defaults on purpose: the compose file refuses to start without them,
# which is better than a panel that quietly comes up with a password somebody can guess.

# The one path that has to be the same on the host and inside the worker container, because the
# worker passes it back to the host's Docker daemon as a bind mount for every download. Changing it
# after the first run orphans the existing history; move the directory instead.
REEL_DATA_ROOT=/opt/euronic-reel/data

# scrypt hash of the panel password. Set with `./deploy.sh password`.
REEL_PASSWORD_HASH=

# Signs session cookies. Changing it signs everyone out.
REEL_SESSION_SECRET=

# Optional. Lets a script queue a download without a browser session:
#   curl -X POST -H "Authorization: Bearer $REEL_API_TOKEN" \
#        -d '{"url":"https://..."}' https://reel.example.com/api/jobs
REEL_API_TOKEN=

# The domain nginx serves this on, set by `./deploy.sh domain`. Empty means nothing is proxying it.
REEL_DOMAIN=

# Where the panel listens on the host. `./deploy.sh domain` sets this to 127.0.0.1, so that once
# nginx is in front the container's own port is not reachable from anywhere else.
REEL_BIND=0.0.0.0
REEL_HTTP_PORT=3200

# These jobs are bound by the source's upload speed rather than by this machine, so a little
# concurrency helps and a lot only shares the same pipe out more thinly.
REEL_MAX_CONCURRENT_JOBS=2

# A download over this many seconds has its container torn down.
REEL_JOB_TIMEOUT_SECONDS=3600
REEL_JOB_MEMORY=1g

# Refused before anything is fetched. A playlist of a thousand items is nobody's intention, and it
# fills a disk.
REEL_MAX_ITEMS=50

# Downloads kept with their files. Older ones keep their row in the history and lose their contents,
# which is what stops the disk filling up silently.
REEL_JOB_RETENTION=50

# Spotify application credentials, set by `./deploy.sh spotify`. They read a public playlist's track
# list — titles, artists, ISRCs — and nothing else. There is no audio behind this feature.
REEL_SPOTIFY_CLIENT_ID=
REEL_SPOTIFY_CLIENT_SECRET=

# The image holding yt-dlp and ffmpeg. Rebuild it with `./deploy.sh update-fetcher`.
REEL_FETCHER_IMAGE=euronic/reel-fetcher:local
